{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ritomer:evals:mapping:reviews:042a2:reviewer-response-schema-v2",
  "title": "042a2 reviewer response schema v2",
  "description": "Documentary schema for a future human review response without expected-answer or oracle fields. It is not an operational collection contract and does not authorize review distribution, adjudication, golden promotion or provider activity.",
  "$comment": "DRAFT; NOT_EXECUTABLE; NOT_DISTRIBUTABLE; NOT_VALIDATED_BY_DRAFT_2020_12_ENGINE. JSON syntax and repository invariants checked; Draft 2020-12 semantic validation not performed.",
  "x-ritomer-status": [
    "DRAFT",
    "NOT_EXECUTABLE",
    "NOT_DISTRIBUTABLE",
    "NOT_VALIDATED_BY_DRAFT_2020_12_ENGINE"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/RealRoundResponse"
    },
    {
      "$ref": "#/$defs/DryRunResponse"
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "const": "042a2-reviewer-response-v2"
    },
    "ArtifactStatus": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "NOT_GOLDEN"
        },
        {
          "const": "NOT_AUTHORITATIVE"
        }
      ],
      "items": false
    },
    "ReviewRoundId": {
      "type": "string",
      "pattern": "^review-round-[a-z0-9][a-z0-9-]{0,79}$"
    },
    "ReviewerPseudonym": {
      "description": "Future pseudonyms must be generated automatically and randomly, be limited to one review round, not be derived from a name, e-mail, employee identifier, employer or HR identifier, and not be reused across rounds without explicit approval. This documentary schema constrains only shape and does not prove those procedural properties.",
      "type": "string",
      "pattern": "^reviewer-[a-z0-9][a-z0-9-]{0,39}$"
    },
    "ReviewCaseId": {
      "type": "string",
      "pattern": "^(BR-(00[1-9]|01[0-7])|DRY-[A-Z0-9][A-Z0-9-]{0,63})$"
    },
    "BlindCaseId": {
      "type": "string",
      "pattern": "^BR-(00[1-9]|01[0-7])$"
    },
    "DryRunCaseId": {
      "type": "string",
      "pattern": "^DRY-[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "AllBlindCaseIdsExactlyOnce": {
      "description": "Each governed BR-001 through BR-017 identifier must occur exactly once in a REAL_ROUND response.",
