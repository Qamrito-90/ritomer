    "TargetCode": {
      "type": "string",
      "enum": [
        "BS.ASSET.CASH_AND_EQUIVALENTS",
        "BS.ASSET.TRADE_RECEIVABLES",
        "BS.LIABILITY.TRADE_PAYABLES",
        "BS.EQUITY.RETAINED_EARNINGS",
        "PL.REVENUE.OPERATING_REVENUE",
        "PL.EXPENSE.OTHER_OPERATING_EXPENSES"
