# Documentation only; never load this file into the M1.1D rail or Vite.
# Canonical local browser authentication: server session; no bearer or HMAC prerequisite.
# application-local.yml enables the session boundary and binds 127.0.0.1:8080.
# The guarded D bootstrap projects its disposable runner and storage settings in memory.
# No datasource credential belongs in this example or in a local .env file.
# application-dev.yml remains an explicit, separate backend legacy bearer profile.

# Optional DB tests remain disabled. This is NOT a standalone dbIntegrationTest recipe.
# Exact run provenance, identity, storage, object/runtime bindings and separate authorization
# are mandatory; see runbooks/local-dev.md (R2 from PR #122, unrelated to historical 043c R2).
RITOMER_DB_TESTS_ENABLED=false

# M1.2 shared-internal: parameter NAMES only, supplied by the future authorized runtime.
# Do not source this file; no real OAuth client, secret, project or personal account belongs here.
# RITOMER_SHARED_ORIGIN=<canonical HTTPS origin, no trailing slash>
# RITOMER_SHARED_OIDC_CLIENT_ID=<dedicated client id>
# RITOMER_SHARED_OIDC_CLIENT_SECRET=<secret supplied to the runtime only>
# RITOMER_SHARED_CLOUD_RUN_SERVICE=<expected exact service name>
# RITOMER_SHARED_DB_URL=<JDBC PostgreSQL URL for the dedicated logical database>
# RITOMER_SHARED_DB_USER=<least-privilege application role>
# RITOMER_SHARED_DB_PASSWORD=<runtime secret>
# RITOMER_SHARED_DB_CA_PATH=<trusted server CA path for verify-full>
# shared-internal rejects legacy HMAC, mixed profiles and a missing frontend bundle.
# Schema migration, real DB access and Cloud deployment require separate authorization.
