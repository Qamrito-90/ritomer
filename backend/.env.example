# Documentation only; never load this file into the M1.1D rail or Vite.
# Canonical local browser authentication: server session; no bearer or HMAC prerequisite.
# application-local.yml enables the session boundary and binds 127.0.0.1:8080.
# The guarded D bootstrap projects its disposable runner and storage settings in memory.
# No datasource credential belongs in this example or in a local .env file.
# application-dev.yml remains an explicit, separate backend legacy bearer profile.

# Optional DB tests remain disabled. This is NOT a standalone dbIntegrationTest recipe.
# Exact run provenance, identity, storage, object/runtime bindings and separate authorization
# are mandatory; see runbooks/local-dev.md (R2 from PR #122, unrelated to historical 043c R2).
RITOMER_DB_TESTS_ENABLED=false
